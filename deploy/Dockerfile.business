ARG MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.10.0-eclipse-temurin-17
ARG JAVA_IMAGE=eclipse-temurin:17-jre-jammy
FROM ${MAVEN_IMAGE} AS build
WORKDIR /build
ENV MAVEN_OPTS="-Xmx384m -XX:MaxMetaspaceSize=192m"
COPY pom.xml ./pom.xml
COPY src ./src
RUN --mount=type=cache,target=/root/.m2 mvn -B -ntp package

FROM ${JAVA_IMAGE}
WORKDIR /opt/tianmu
COPY --from=build /build/target/tianmu-0.0.1-SNAPSHOT.jar ./business.jar
COPY deploy/site/business-entrypoint.sh ./entrypoint.sh
RUN chmod 0555 entrypoint.sh
USER 10001:10001
EXPOSE 8101 9101
ENTRYPOINT ["/bin/sh", "/opt/tianmu/entrypoint.sh"]
